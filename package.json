{
  "name": "glass-shelf",
  "version": "0.1.0",
  "description": "A glassy, two-panel Spotlight Library for Steam Game Mode.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "rollup -c",
    "package": "python scripts/package.py",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "author": "Scott Babcock",
  "repository": {
    "type": "git",
    "url": "https://github.com/scottbabcock/glass-shelf.git"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "linkedom": "^0.18.13",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
